# ---------------------------------------------------------------------------
# Bank Statement Intelligence - backend environment
# Copy to .env and fill in real values. NEVER expose these to the frontend.
# ---------------------------------------------------------------------------

# PostgreSQL is the financial source of truth.
DATABASE_URL=postgresql://postgres:password@localhost:5432/bank_statement_db

# Signing key for auth tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left empty an ephemeral key is generated at boot (tokens reset on restart).
SECRET_KEY=

# --- Auth -------------------------------------------------------------------
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- JEV / TypeSafe AI ------------------------------------------------------
# JEV is the structured decision layer for person/counterparty matching.
# When JEV_ENABLED=false the deterministic LOCAL_MATCHING layer is used instead
# and results are clearly labelled LOCAL_MATCHING (never faked as JEV).
JEV_ENABLED=false
TYPESAFE_API_KEY=
TYPESAFE_API_BASE=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=15

# --- RAG --------------------------------------------------------------------
RAG_ENABLED=true
# local = deterministic on-disk embedding (no external call), openai = real embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=384
# LLM used only to phrase already-verified results. Financial totals always
# come from SQL/Python, never from the LLM. none = deterministic templates.
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Security / uploads -----------------------------------------------------
MAX_UPLOAD_SIZE_MB=20
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
